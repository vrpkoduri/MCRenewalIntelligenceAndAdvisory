{
  "datasets": [
    {
      "name": "ds_counts",
      "displayName": "Rung counts",
      "queryLines": [
        "SELECT count(*) AS total_merchants, sum(case when lifecycle_state='active' then 1 else 0 end) AS active_merchants, sum(case when direction_of_travel='sliding' then 1 else 0 end) AS sliding_merchants, sum(case when lifecycle_state='defaulted' then 1 else 0 end) AS defaulted_merchants, sum(case when is_unclassified then 1 else 0 end) AS unclassified_merchants FROM mca_mri.gold.merchant_rung_current"
      ]
    },
    {
      "name": "ds_state_counts",
      "displayName": "State counts",
      "queryLines": [
        "SELECT sum(case when current_state='approaching' then 1 else 0 end) AS approaching, sum(case when current_state='in-market' then 1 else 0 end) AS in_market FROM mca_mri.gold.merchant_activation_current"
      ]
    },
    {
      "name": "ds_rung_dist",
      "displayName": "Rung distribution",
      "queryLines": [
        "SELECT coalesce(cast(rung as string),'(gated/unclassified)') AS rung_label, count(*) AS n FROM mca_mri.gold.merchant_rung_current GROUP BY 1 ORDER BY 1"
      ]
    },
    {
      "name": "ds_lifecycle_dist",
      "displayName": "Lifecycle distribution",
      "queryLines": [
        "SELECT lifecycle_state, count(*) AS n FROM mca_mri.gold.merchant_rung_current GROUP BY 1 ORDER BY 2 DESC"
      ]
    },
    {
      "name": "ds_play_dist",
      "displayName": "Play distribution",
      "queryLines": [
        "SELECT active_play, count(*) AS n FROM mca_mri.gold.merchant_activation_current GROUP BY 1 ORDER BY 2 DESC"
      ]
    },
    {
      "name": "ds_bookhealth",
      "displayName": "Book Health metrics",
      "queryLines": [
        "SELECT view, metric, dimension_value, value_num, value_pct FROM mca_mri.gold.book_health WHERE report_date=(SELECT max(report_date) FROM mca_mri.gold.book_health) ORDER BY view, metric, dimension_value"
      ]
    },
    {
      "name": "ds_queue",
      "displayName": "Daily queue",
      "queryLines": [
        "SELECT q.queue_rank, m.business_name, q.merchant_id, q.rung, q.lifecycle_state, q.current_state, q.active_play, q.play_sla_due, q.direction_of_travel, q.confidence, q.next_tactical_action FROM mca_mri.gold.daily_queue q LEFT JOIN mca_mri.gold.merchants m ON q.merchant_id=m.merchant_id ORDER BY q.queue_rank LIMIT 250"
      ]
    },
    {
      "name": "ds_360",
      "displayName": "Merchant 360",
      "queryLines": [
        "SELECT m.business_name, r.merchant_id, r.rung, r.lifecycle_state, r.confidence, r.direction_of_travel, r.route, c.est_paydown_pct, c.is_eligible_now, c.est_renewal_eligible_date, a.current_state, a.active_play, a.play_sla_due, a.next_tactical_action, a.next_strategic_nudge, p.p_alive, p.p_defection, p.predicted_next_event_date, p.predicted_clv, p.prediction_confidence, p.insufficient_history FROM mca_mri.gold.merchant_rung_current r LEFT JOIN mca_mri.gold.merchant_clock_current c ON r.merchant_id=c.merchant_id LEFT JOIN mca_mri.gold.merchant_activation_current a ON r.merchant_id=a.merchant_id LEFT JOIN mca_mri.gold.merchant_predictions_current p ON r.merchant_id=p.merchant_id LEFT JOIN mca_mri.gold.merchants m ON r.merchant_id=m.merchant_id ORDER BY r.confidence ASC LIMIT 500"
      ]
    }
  ],
